# =============================================================================
#  PYTHON ENCRYPTER - ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
#  HOW TO USE:
#    1. Copy this file and rename the copy to exactly:   .env
#    2. Fill in your own values below (replace every <...> placeholder)
#    3. NEVER commit or share your real .env file
#
#    1 file to copy:      cp .env.example .env
#    1 rule to remember:  real values stay on YOUR machine only
# =============================================================================


# -----------------------------------------------------------------------------
# 1) TELEGRAM BOT
# -----------------------------------------------------------------------------
# Get this from @BotFather on Telegram -> /newbot -> copy the token.
# Looks like: 1234567890:AAExampleTokenReplaceMeWithYourOwnToken
#
# REQUIRED. The bot will not start without it.
BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>


# Your own numeric Telegram user ID. Message @userinfobot to get it.
# This account becomes the ADMIN (unlimited quota, approve/reject buttons,
# all /admin commands). Keep it private.
#
# REQUIRED.
ADMIN_ID=<YOUR_TELEGRAM_NUMERIC_ID>


# The public URL where you host the API server (api/index.py).
# No trailing slash. Example: https://your-app.vercel.app
#
# REQUIRED for the approval system to work.
API_SERVER_URL=<YOUR_API_SERVER_URL>


# -----------------------------------------------------------------------------
# 2) FIREBASE REALTIME DATABASE
# -----------------------------------------------------------------------------
# Create a project at https://console.firebase.google.com
# Realtime Database -> copy the URL shown at the top.
# Looks like: https://your-project-default-rtdb.firebaseio.com
#
# REQUIRED.
FIREBASE_DATABASE_URL=<YOUR_FIREBASE_DATABASE_URL>


# Optional. A Database Secret from:
#   Firebase Console -> Project Settings -> Service Accounts -> Database Secrets
#
# WARNING - read this twice:
#   This value is a FULL-ACCESS key to your entire database. Anyone who has it
#   can read every licence key you have ever issued.
#   Leave it EMPTY and use Firebase Security Rules instead if you can.
#   Never paste it into a public repo, a zip you share, or a screenshot.
FIREBASE_DATABASE_SECRET=<OPTIONAL_YOUR_FIREBASE_DATABASE_SECRET>


# -----------------------------------------------------------------------------
# 3) OPTIONAL - UPTIME KEEPALIVE (container hosts like Render/Railway)
# -----------------------------------------------------------------------------
# If your host sleeps when idle, set one of these so the app can ping itself.
# Leave empty on Vercel or if your host stays awake.
# RENDER_EXTERNAL_URL=<YOUR_RENDER_PUBLIC_URL>
# APP_URL=<YOUR_PUBLIC_URL>
